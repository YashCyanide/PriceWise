# MongoDB Configuration
# Get your MongoDB connection string from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# or use local MongoDB: mongodb://localhost:27017/pricewise
MONGODB_URI=

# BrightData Proxy Configuration
# Sign up at https://brightdata.com/ and create a proxy zone
BRIGHT_DATA_USERNAME=
BRIGHT_DATA_PASSWORD=

# Email Configuration
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# For Outlook: Use regular password
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: Hugging Face Token
# Get token from https://huggingface.co/settings/tokens
HF_TOKEN=
